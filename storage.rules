rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Applicant uploads into their own folder (keyed by their login) and can
    // read their own files back; only the office can see anyone else's.
    match /driver_applications/{applicantId}/{fileName} {
      allow write: if isSignedIn() && request.auth.uid == applicantId
                    && fileName.matches('.*\\.(pdf|jpg|jpeg|png|doc|docx)$')
                    && request.resource.size < 15 * 1024 * 1024;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == applicantId);
      allow delete: if isAdmin();
    }

    match /id_verification/{uid}/{fileName} {
      allow write: if isSignedIn() && request.auth.uid == uid
                    && fileName.matches('.*\\.(jpg|jpeg|png)$')
                    && request.resource.size < 10 * 1024 * 1024;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /logos/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
