rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Applicant uploads into their own folder (keyed by their login) and can
    // read their own files back; only the office can see anyone else's.
    match /driver_applications/{applicantId}/{fileName} {
      allow write: if isSignedIn() && request.auth.uid == applicantId
                    && fileName.matches('.*\\.(pdf|jpg|jpeg|png|doc|docx)$')
                    && request.resource.size < 15 * 1024 * 1024;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == applicantId);
      allow delete: if isAdmin();
    }

    // Proof for driver certifications (base pass, van training).
    match /driver_certs/{uid}/{fileName} {
      allow write: if isSignedIn() && request.auth.uid == uid
                    && fileName.matches('.*\\.(pdf|jpg|jpeg|png)$')
                    && request.resource.size < 10 * 1024 * 1024;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    // Vehicle inspection photos and walk-around videos, in the driver's own folder.
    // Kept (no delete by drivers): they are the record of the car's condition.
    match /inspections/{uid}/{fileName} {
      allow create: if isSignedIn() && request.auth.uid == uid && request.auth.token.driver == true
                    && ((request.resource.contentType.matches('image/.*') && request.resource.size < 12 * 1024 * 1024)
                        || (request.resource.contentType.matches('video/.*') && request.resource.size < 250 * 1024 * 1024));
      allow read: if isSignedIn() && (request.auth.uid == uid || request.auth.token.admin == true || request.auth.token.shop == true);
      allow update, delete: if isAdmin();
    }

    // Rider profile photo.
    match /profile_photos/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /id_verification/{uid}/{fileName} {
      allow write: if isSignedIn() && request.auth.uid == uid
                    && fileName.matches('.*\\.(jpg|jpeg|png)$')
                    && request.resource.size < 10 * 1024 * 1024;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /logos/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
