rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    function isShop() {
      return isSignedIn() && (request.auth.token.admin == true || request.auth.token.shop == true);
    }
    function isDriver() {
      return isSignedIn() && request.auth.token.driver == true;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isNotBlacklisted() {
      return request.resource.data.phone is string
        && !exists(/databases/$(database)/documents/blacklist_phones/$(request.resource.data.phone));
    }

    // Money and membership on a user record are set by the server only
    // (Stripe webhooks / Cloud Functions), never by the rider's own app.
    function userServerKeys() {
      return ['walletBalance', 'subscriptionTier', 'subscriptionStatus', 'stripeCustomerId',
              'stripeSubscriptionId', 'smsAddonStatus', 'birthdayCredits',
              'dayPass', 'feesOwedCents', 'feesOwed'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.get('walletBalance', 0) == 0
        && request.resource.data.get('subscriptionTier', null) == null
        && !request.resource.data.keys().hasAny(userServerKeys().removeAll(['walletBalance', 'subscriptionTier']));
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['firstName', 'lastName', 'phone', 'address', 'dob',
                           'idImageUrl', 'idSubmittedAt', 'idVerified', 'rating', 'active',
                           'legal', 'marketingOptIn', 'photoUrl', 'photoCheck'])
            // A new ID photo resets verification; only the dispatcher can verify.
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['idVerified'])
                || request.resource.data.idVerified == false));
      allow delete: if isAdmin();
    }

    // Ride fields only dispatch (Cloud Functions / dispatcher) may set.
    function rideServerKeys() {
      return ['driverId', 'carNumber', 'dispatchState', 'offer', 'offerSeq', 'offerDriverId',
              'triedDriverIds', 'broadcastTo', 'broadcastAt', 'escalatedAt', 'escalateReason',
              'assignedAt', 'assignedHow', 'zoneId', 'zoneLabel', 'dropZoneId', 'requiresCerts',
              'priority', 'dispatchAt', 'zoneAssignedAt', 'lastMiss', 'requestedDriverId',
              'pickedUpAt', 'droppedOffAt', 'source', 'enteredBy', 'zoneSetBy',
              'tipAmount', 'capturedAmountCents', 'stripeStatus', 'cardFeeCents', 'settledBy',
              'memberDiscountApplied', 'ledgerCreditedAt',
              // Pickup timing, perks, fees and calls: server-written only.
              'perks', 'termsMissing', 'eta', 'headsUpAt', 'driverPos', 'riderPos', 'riderReply',
              'arrivedAt', 'arrivedDistM', 'arrivedFix', 'waitedMs', 'fee', 'calls',
              'cancelFeeCents', 'cancelledBy', 'cancelledAt', 'earlierFeesCents', 'termsRead'];
    }

    match /rides/{rideId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isNotBlacklisted()
        && request.resource.data.status == 'pending'
        && request.resource.data.get('finalFare', null) == null
        && (request.resource.data.customerId == 'guest'
            || (isSignedIn() && request.resource.data.customerId == request.auth.uid))
        && !request.resource.data.keys().hasAny(rideServerKeys());
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.customerId == request.auth.uid && resource.data.status == 'pending'
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(rideServerKeys().concat(['status', 'customerId', 'finalFare', 'paymentIntentId'])))
        || (isSignedIn() && resource.data.customerId == request.auth.uid
            && resource.data.status in ['finished', 'archived']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating']));
      allow delete: if isAdmin();
    }

    // One application per driver login, keyed by their uid.
    match /driver_applications/{appId} {
      allow create: if isSignedIn()
        && appId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || isOwner(appId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Driver profile: car #, certs, warnings, lease credit. Only the office
    // (or Cloud Functions) can change it; drivers can read their own.
    match /drivers/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    // Public zone-board entry (car #, status, zone, place in line). Every
    // driver can see the board; only Cloud Functions write it, so nobody
    // can move themselves up the line.
    // A driver's record: warnings, write-ups, incidents. Server-written.
    match /drivers/{uid}/record/{entryId} {
      allow read: if isAdmin() || (isDriver() && request.auth.uid == uid);
      allow write: if false;
    }

    match /board/{uid} {
      allow read: if isAdmin() || isDriver();
      allow write: if false;
    }

    // Exact GPS position: the dispatcher's map and the driver himself only.
    // Written by the driverPing callable, never by the app directly.
    match /driverLocations/{uid} {
      allow read: if isAdmin() || (isDriver() && request.auth.uid == uid);
      allow write: if false;
    }

    // A driver's own offer, "Need a car" broadcasts and current ride.
    // Server-written; drivers never read the rides collection.
    match /driverInbox/{uid} {
      allow read: if isAdmin() || (isDriver() && request.auth.uid == uid);
      allow write: if false;
    }

    // Push tokens: server only.
    match /driverTokens/{uid} {
      allow read, write: if false;
    }

    // Lease ledger: periods and card-fare / adjustment entries. Server-written.
    match /ledger/{uid}/{document=**} {
      allow read: if isAdmin() || (isDriver() && request.auth.uid == uid);
      allow write: if false;
    }

    // Lease envelopes dropped in the safe, and the office count.
    match /envelopes/{envelopeId} {
      allow read: if isAdmin() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow write: if false;
    }

    // Close-out payouts (check to a driver who left). Server-written.
    match /payouts/{payoutId} {
      allow read: if isAdmin() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow write: if false;
    }

    // Dispatch mode (manual / auto / scheduled) and other office settings.
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Driver asks for a certification (base pass, wheelchair van). Doc id is
    // "<uid>_<cert>" so each driver has one request per cert.
    match /certRequests/{reqId} {
      allow read: if isAdmin() || (isSignedIn() && reqId.matches(request.auth.uid + '_.*'));
      allow create, update: if isAdmin()
        || (isDriver()
            && reqId == request.auth.uid + '_' + request.resource.data.cert
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.cert in ['base', 'wheelchair']);
      allow delete: if isAdmin();
    }

    // Zone names + map shapes (drawn in the admin Zone Editor).
    match /zones/{zoneId} {
      allow read: if isAdmin() || isDriver();
      allow write: if isAdmin();
    }

    // Fleet: car #, plate, wheelchair van flag.
    match /vehicles/{carNumber} {
      allow read: if isShop() || isDriver();
      allow write: if isAdmin();
    }

    // Inspections are filed only through submitInspection (server checks
    // and stamps them). The driver who filed one, the office and the shop can read it.
    match /vehicle_inspections/{id} {
      allow read: if isShop() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow write: if false;
    }

    // Shop work orders: changed only through the work-order functions.
    match /work_orders/{id} {
      allow read: if isShop() || (isDriver() && resource.data.reportedBy.uid == request.auth.uid);
      allow write: if false;
    }

    // Driver emergencies and call problems, for the dispatch desk. Written by functions only.
    match /alerts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Copies of rides riders cancelled; office only.
    match /cancelled_rides/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /blacklist/{entryId} {
      allow read, write: if isAdmin();
    }

    match /blacklist_phones/{phone} {
      allow read, write: if isAdmin();
    }

    // Repeat phone callers (name + usual places), for dispatcher Quick Entry.
    match /phoneRiders/{phone} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /promo_codes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
