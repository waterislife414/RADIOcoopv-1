rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    function isDriver() {
      return isSignedIn() && request.auth.token.driver == true;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isNotBlacklisted() {
      return request.resource.data.phone is string
        && !exists(/databases/$(database)/documents/blacklist_phones/$(request.resource.data.phone));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['firstName', 'lastName', 'phone', 'address', 'dob',
                           'idImageUrl', 'idSubmittedAt', 'rating', 'walletBalance', 'active']));
      allow delete: if isAdmin();
    }

    match /rides/{rideId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isNotBlacklisted();
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.customerId == request.auth.uid && resource.data.status == 'pending')
        || (isSignedIn() && resource.data.customerId == request.auth.uid
            && resource.data.status in ['finished', 'archived']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating']));
      allow delete: if isAdmin();
    }

    // One application per driver login, keyed by their uid.
    match /driver_applications/{appId} {
      allow create: if isSignedIn()
        && appId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || isOwner(appId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Driver profile: car #, certs, warnings, lease credit. Only the office
    // (or Cloud Functions) can change it; drivers can read their own.
    match /drivers/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    // Public zone-board entry (car #, status, zone, place in line). Every
    // driver can see the board; only Cloud Functions write it, so nobody
    // can move themselves up the line.
    match /board/{uid} {
      allow read: if isAdmin() || isDriver();
      allow write: if false;
    }

    // Driver asks for a certification (base pass, wheelchair van). Doc id is
    // "<uid>_<cert>" so each driver has one request per cert.
    match /certRequests/{reqId} {
      allow read: if isAdmin() || (isSignedIn() && reqId.matches(request.auth.uid + '_.*'));
      allow create, update: if isAdmin()
        || (isDriver()
            && reqId == request.auth.uid + '_' + request.resource.data.cert
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.cert in ['base', 'wheelchair']);
      allow delete: if isAdmin();
    }

    // Zone names + map shapes (drawn in the admin Zone Editor).
    match /zones/{zoneId} {
      allow read: if isAdmin() || isDriver();
      allow write: if isAdmin();
    }

    // Fleet: car #, plate, wheelchair van flag.
    match /vehicles/{carNumber} {
      allow read: if isAdmin() || isDriver();
      allow write: if isAdmin();
    }

    match /blacklist/{entryId} {
      allow read, write: if isAdmin();
    }

    match /blacklist_phones/{phone} {
      allow read, write: if isAdmin();
    }

    match /promo_codes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
