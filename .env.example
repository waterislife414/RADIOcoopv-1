# ---------------------------------------------------------------------------
# Kyle's Auto & Mobile Repair — environment
# Copy to .env.local for dev. Set the same keys in Vercel / Netlify.
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.
# ---------------------------------------------------------------------------

# Public base URL (no trailing slash). Used for Stripe redirects, emails, QR codes, OG tags.
NEXT_PUBLIC_SITE_URL=https://www.kylesautorepair.com

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Stripe — Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring prices (run `npm run stripe:setup` to create these and print the IDs)
STRIPE_PRICE_DAILY_DRIVER_MONTHLY=price_xxx
STRIPE_PRICE_DAILY_DRIVER_ANNUAL=price_xxx
STRIPE_PRICE_FAMILY_MONTHLY=price_xxx
STRIPE_PRICE_FAMILY_ANNUAL=price_xxx
# Optional: base fleet price ($149/mo). Leave blank to make fleet "quote only".
STRIPE_PRICE_FLEET_MONTHLY=
# Stripe no-code customer portal login link (Settings → Billing → Customer portal → "Login link")
NEXT_PUBLIC_STRIPE_PORTAL_LOGIN_URL=https://billing.stripe.com/p/login/xxx

# Resend — verified sending domain required for production
RESEND_API_KEY=re_xxx
# Must be on a domain verified in Resend. reply_to is hard-wired to kyledubios2412@gmail.com.
EMAIL_FROM="Kyle's Auto & Mobile Repair <service@kylesautorepair.com>"
